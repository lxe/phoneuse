#!/bin/sh
""":"
# phoneuse launcher: runs the CLI from this checkout (no install step needed).
# This part is sh: it finds a Python (the Windows venv first, for Git Bash, then the
# Windows app's own in core/python), then runs this same file with it; the rest is Python.
# (No backslashes up here: this is also a Python string, where they'd be escapes.)
here=$(dirname "$0")
# The portable Windows app keeps its settings in data/ beside it (as bin/phoneuse.cmd does)
if [ -f "$here/../../portable" ] && [ -z "$PHONEUSE_CONFIG_DIR" ]; then export PHONEUSE_CONFIG_DIR="$here/../../data"; fi
for py in "$here/../.venv/Scripts/python.exe" "$here/../python/python.exe" python3 python; do
  if command -v "$py" >/dev/null 2>&1; then exec "$py" "$0" "$@"; fi
done
echo "phoneuse: no Python found" >&2
exit 1
":"""
import os
import sys

if ".app/Contents/" in os.path.realpath(__file__):
    sys.dont_write_bytecode = True  # inside the Mac app: a .pyc written there breaks its signature
sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
from phoneuse.cli import main  # noqa: E402

main()
